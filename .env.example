# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env. Never put a real key or password in this file.

# PostgreSQL connection string.
# Supabase: Project Settings -> Database -> Connection string (URI).
# Use the SQLAlchemy driver prefix postgresql+psycopg://
# Local example:
# postgresql+psycopg://postgres:postgres@localhost:5432/job_matching
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Google AI Studio key used for Gemini match explanations.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model name. Leave unset to use gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional embedding model. Leave unset to use models/gemini-embedding-2.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Minimum cosine similarity for a related skill. Exact matches always count.
GEMINI_SKILL_SIMILARITY_THRESHOLD=0.75

# Adzuna job search credentials. Create an application at https://developer.adzuna.com/
# These are used by the connection check only. Never commit real values.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Comma-separated browser origins allowed to call the API.
# Leave blank locally to allow http://localhost:8501 and http://127.0.0.1:8501.
CORS_ORIGINS=

# The Streamlit app reads these from its own environment, then from Streamlit secrets.
# Leave them unset locally. API_URL then stays http://127.0.0.1:8001 and the cookie
# is not marked Secure. On Streamlit Community Cloud, set them in secrets instead:
# API_URL = "https://your-api-host.example.com"
# COOKIE_SECURE = true
